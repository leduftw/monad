# Build output, tooling artefacts, and OS clutter.
#
# Deliberately short. This replaced GitHub's 367-line VisualStudio template,
# which covered ReSharper, ClickOnce, Azure, BizTalk, Silverlight, TFS and much
# else this repository has never used -- while missing .DS_Store entirely.

# --- .NET build output ---
[Bb]in/
[Oo]bj/
artifacts/
*.binlog

# --- Test and coverage output ---
[Tt]est[Rr]esults/
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# --- NuGet ---
*.nupkg
*.snupkg

# --- Native (Swift) build artefacts ---
# The macOS sidecar normally builds into Monad/obj/audiotap, but running swiftc
# by hand leaves the binary wherever it was invoked.
monad-audiotap
*.o
*.dSYM/
.build/

# --- Local configuration and secrets ---
# monad.json is a documented config location and can hold an AudD API token,
# so it must never reach the history. Commit a token-free example instead.
monad.json
.env
.env.local

# --- Editors and IDEs ---
.vs/
.idea/
*.user
*.suo
*.swp
*.swo
*~

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes
.fseventsd

# --- Windows ---
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# --- Linux ---
.directory
.Trash-*
.nfs*

# --- Claude Code local settings ---
.claude/settings.local.json
.claude/*.local.json
.claude/*.local.md
